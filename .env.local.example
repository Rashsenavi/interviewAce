# ─── Frontend Environment Variables Template ──────────────────────────────────
# Copy this file to .env.local and fill in local values.
# Backend variables live in backend/.env.local (use backend/.env.example as template).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# Port 6543 = PgBouncer (transaction mode) — required for Drizzle migrations
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ─── Backend Proxy (Next.js API routes forward to Express) ───────────────────
BACKEND_URL=http://localhost:3001

# ─── Public API (client-side fetch base URL) ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_TIMEOUT=30000

# ─── Supabase (client-side — anon key only, safe for browser) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key-here

# ─── PayHere (client-side — public config only, no secrets) ──────────────────
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=your_merchant_id_here
NEXT_PUBLIC_PAYHERE_SANDBOX=true
NEXT_PUBLIC_PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
NEXT_PUBLIC_PAYHERE_APP_URL=http://localhost:3000

# ─── JWT (frontend display only) ─────────────────────────────────────────────
NEXT_PUBLIC_JWT_EXPIRY=24h

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
