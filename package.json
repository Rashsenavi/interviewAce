{
  "name": "interviewace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "dev:backend": "NODE_OPTIONS=--dns-result-order=ipv4first npm --prefix backend run dev",
    "dev:all": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev\" \"npm run dev:backend\"",
